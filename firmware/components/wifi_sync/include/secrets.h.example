#pragma once

/*
 * Copy this file to secrets.h (gitignored) and fill in real values.
 * secrets.h is never committed — wifi_sync.c includes it directly.
 *
 * STICKS3_DEVICE_TOKEN must match DEVICE_TOKEN in local-receiver/.env
 * on the Mac running the receiver. STICKS3_RECEIVER_URL must point at
 * that Mac's LAN address and the receiver's port (default 8090).
 *
 * The device is carried around, so it needs to know more than one
 * Wi-Fi network (e.g. home and office). List every network the Wi-Fi
 * Sync client is allowed to join; at sync time it scans and connects
 * to whichever entry it finds, trying them in the order listed. If
 * none of these are in range, the recording stays on-device — Sync is
 * never required for Capture to keep working.
 */

typedef struct {
    const char *ssid;
    const char *password; // "" for an open network
} sticks3_wifi_network_t;

static const sticks3_wifi_network_t STICKS3_WIFI_NETWORKS[] = {
    { "home-wifi-ssid", "home-wifi-password" },
    { "office-wifi-ssid", "office-wifi-password" },
};

#define STICKS3_WIFI_NETWORK_COUNT \
    (sizeof(STICKS3_WIFI_NETWORKS) / sizeof(STICKS3_WIFI_NETWORKS[0]))

#define STICKS3_DEVICE_TOKEN  "same-shared-secret-as-local-receiver-env"
#define STICKS3_RECEIVER_URL  "http://192.168.1.100:8090"
