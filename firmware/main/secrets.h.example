#pragma once

/*
 * Copy this file to secrets.h (gitignored) and fill in real values.
 * secrets.h is never committed — main.c / wifi_sync includes it directly.
 *
 * STICKS3_DEVICE_TOKEN must match DEVICE_TOKEN in local-receiver/.env
 * on the Mac running the receiver. STICKS3_RECEIVER_URL must point at
 * that Mac's LAN address and the receiver's port (default 8090).
 */

#define STICKS3_WIFI_SSID     "your-wifi-ssid"
#define STICKS3_WIFI_PASSWORD "your-wifi-password"

#define STICKS3_DEVICE_TOKEN  "same-shared-secret-as-local-receiver-env"
#define STICKS3_RECEIVER_URL  "http://192.168.1.100:8090"
