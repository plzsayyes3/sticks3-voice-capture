# Copy to .env and fill in. Never commit the real .env.

# Shared secret the StickS3 sends as "Authorization: Bearer <token>".
DEVICE_TOKEN=

# GitHub personal access token with contents:write on the mynotebook repo.
# Leave unset to disable mynotebook push (transcript/markdown are still
# written locally under STICKS3_DATA_DIR).
GITHUB_TOKEN=

# Optional overrides.
# MYNOTEBOOK_REPO=plzsayyes3/mynotebook
# MYNOTEBOOK_BRANCH=main
# MYNOTEBOOK_PATH_PREFIX=00_inbox
# STICKS3_DATA_DIR=~/sticks3-voice-capture-data
# WHISPER_CLI=whisper-cli
# WHISPER_MODEL=~/whisper-models/ggml-large-v3-turbo.bin
# WHISPER_VAD_MODEL=~/whisper-models/ggml-silero-v5.1.2.bin
# WHISPER_LANGUAGE=ja
# WHISPER_DICTIONARY=/absolute/path/to/transcription-dictionary.txt
# PORT=8090

# Automatic vocabulary from my-storage-note/memory/entities/index.json.
# The receiver first looks for a sibling my-storage-note clone. Set
# MY_STORAGE_NOTE_PATH if yours lives elsewhere. If no local clone is found,
# it can fetch the private repo with KNOWLEDGE_GITHUB_TOKEN (or GITHUB_TOKEN).
# ENTITY_DICTIONARY_ENABLED=1
# MY_STORAGE_NOTE_PATH=/absolute/path/to/my-storage-note
# KNOWLEDGE_GITHUB_TOKEN=
# ENTITY_DICTIONARY_REPO=plzsayyes3/my-storage-note
# ENTITY_DICTIONARY_BRANCH=main
# ENTITY_DICTIONARY_KINDS=person,organization,place,concept
# ENTITY_DICTIONARY_MIN_MENTIONS=2
# ENTITY_DICTIONARY_RECENT_DAYS=180
# ENTITY_DICTIONARY_INCLUDE_ALIASES=0
# ENTITY_DICTIONARY_MAX_TERMS=60
# ENTITY_DICTIONARY_MAX_CHARS=280
# ENTITY_DICTIONARY_REFRESH_SECONDS=21600
# WHISPER_PROMPT_MAX_TERMS=80
# WHISPER_PROMPT_MAX_CHARS=320
